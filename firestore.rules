rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Formulaire client public : création seulement.
    // Aucune lecture, modification ou suppression publique.
    match /receipts/{receiptId} {
      allow create: if request.auth == null
                    && request.resource.data.keys().hasAll(['orderNo','customer','receivedDate','issue','rating','createdAt'])
                    && request.resource.data.orderNo is string
                    && request.resource.data.orderNo.size() >= 1
                    && request.resource.data.orderNo.size() <= 80
                    && request.resource.data.customer is string
                    && request.resource.data.customer.size() >= 1
                    && request.resource.data.customer.size() <= 200
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      // Tout utilisateur Firebase Auth connecté est administrateur dans V8.
      allow read, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /orders/{orderId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
